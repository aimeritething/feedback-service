PORT=8080

DATABASE_URL=postgres://user:password@host:5432/feedback

S3_ENDPOINT=https://objectstorageapi.hzh.sealos.run
S3_REGION=us-east-1
S3_BUCKET=xxxx-feedback
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

ALLOWED_REGIONS=hzh.sealos.run,bja.sealos.run,usw.sealos.io
RATE_LIMIT_PER_HOUR=20

FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# 留空则不发卡片
FEISHU_CHAT_ID=
# 留空则用 templates/feedback-card.json
# 填了就用飞书搭建工具里的模板：变量是用户原文（不转义），模板里放用户字段的地方必须用纯文本组件
FEISHU_CARD_TEMPLATE_ID=

BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=
BITABLE_URL=https://xxx.feishu.cn/base/<app_token>

SYNC_INTERVAL_SECONDS=300
DISPLAY_TIMEZONE=Asia/Shanghai
